#!/usr/bin/env bash
#
# Run markdown linting locally
set -e

docker run --rm -v "$PWD:/workdir" --user "$(id -u):$(id -g)" \
    davidanson/markdownlint-cli2 \
    CONTRIBUTING.md MAINTAINERS.md README.md RELEASE.md CODE_OF_CONDUCT.md \
    librclone/README.md backend/s3/README.md \
    'docs/content/{_index,authors,bugs,changelog,docs,downloads,faq,filtering,gui,install,licence,overview,privacy}.md'
